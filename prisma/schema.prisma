datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum SystemRole {
  ADMIN
  SUPERVISORA
  VENDEDORA
  COBRADOR
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PriceType {
  LIST
  LIST_PRICE
  MINIMUM_AUTHORIZED
  CREDIT
  CASH
}

enum WarehouseType {
  CENTRAL
  BRANCH
  MOBILE
  OTHER
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED_TO_DELIVERY
  CANCELLED
}

enum KardexType {
  IN
  INITIAL_STOCK
  PURCHASE_IN
  RESERVATION
  RESERVATION_RELEASE
  DELIVERY_OUT
  RETURN_IN
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ProductOrderStatus {
  PENDING
  ORDERED
  PARTIAL_RECEIVED
  COMPLETED
  CANCELLED
}

enum SaleType {
  CASH
  CREDIT
}

enum SaleStatus {
  DRAFT
  PENDING_AUTHORIZATION
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CreditStatus {
  ACTIVE
  SETTLED
  DEFAULTED
  RESTRUCTURED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ScheduleStatus {
  PENDING
  PARTIAL
  COMPLETED
  OVERDUE
  RESCHEDULED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  OPERATING
  COUNTING
  PENDING_REVIEW
  CLOSED
  CANCELLED
  RECONCILIATION
}

enum MovementType {
  OPENING_FUND
  PAYMENT
  DOWN_PAYMENT
  EXPENSE
  WITHDRAWAL
  REFUND
  ADJUSTMENT
  OTHER_INCOME
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  phone                String?
  passwordHash         String
  firstName            String
  lastName             String
  accountStatus        AccountStatus @default(ACTIVE)
  failedLoginAttempts  Int           @default(0)
  lockoutUntil         DateTime?
  passwordChangedAt    DateTime?
  permissionVersion    Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  userRoles            UserRoleMapping[]
  salesAsSeller        Sale[]        @relation("SellerSales")
  salesAsSupervisor    Sale[]        @relation("SupervisorSales")
  paymentsAsCollector  Payment[]     @relation("CollectorPayments")
  cashSessions         CashSession[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        SystemRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRoleMapping[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRoleMapping {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Client {
  id                 String       @id @default(uuid())
  clientNumber       String       @unique
  firstName          String
  lastName           String
  secondLastName     String?
  phone              String
  secondaryPhone     String?
  email              String?
  dateOfBirth        DateTime?
  occupation         String?
  customerType       String       @default("NEW")
  status             ClientStatus @default(PROSPECT)
  riskLevel          RiskLevel    @default(LOW)
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  locationCapturedAt DateTime?
  createdBy          String?
  assignedSellerId   String?
  assignedCollectorId String?
  zoneId             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sales       Sale[]
  credits     Credit[]
  addresses   ClientAddress[]
  references  ClientReference[]
  profile     ClientProfile?
  media       ClientMedia[]
  timeline    ClientTimeline[]
  riskHistory ClientRiskHistory[]
  notes       ClientNote[]
  visits      ClientVisit[]
  renewals    ClientRenewal[]
  promises    PaymentPromise[]
  collectionVisits CollectionVisit[]

  @@index([phone])
  @@index([clientNumber])
  @@index([status])
  @@index([riskLevel])
  @@index([assignedSellerId])
  @@index([assignedCollectorId])
  @@index([zoneId])
  @@map("clients")
}

model ClientAddress {
  id             String    @id @default(uuid())
  clientId       String
  addressType    String    @default("HOME")
  street         String
  exteriorNumber String
  interiorNumber String?
  neighborhood   String
  postalCode     String
  city           String
  municipality   String?
  state          String
  country        String    @default("MEXICO")
  references     String?
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  isPrimary      Boolean   @default(false)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

model ClientReference {
  id             String   @id @default(uuid())
  clientId       String
  name           String
  relationship   String
  phone          String
  secondaryPhone String?
  address        String?
  occupation     String?
  referenceType  String   @default("PERSONAL")
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_references")
}

model ClientProfile {
  id                     String    @id @default(uuid())
  clientId               String    @unique
  occupation             String?
  businessActivity       String?
  paymentPreference      String?
  preferredCollectionDay String?
  preferredPaymentMethod String?
  incomeRange            String?
  customerSince          DateTime?
  salesNotes             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ClientMedia {
  id              String    @id @default(uuid())
  clientId        String
  mediaType       String
  url             String
  storageKey      String?
  mimeType        String?
  fileSize        Int?
  checksum        String?
  latitude        Float?
  longitude       Float?
  capturedAt      DateTime?
  uploadedAt      DateTime  @default(now())
  uploadedBy      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  status          String    @default("PENDING_REVIEW")
  replacedMediaId String?
  createdAt       DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("client_media")
}

model ClientTimeline {
  id          String   @id @default(uuid())
  clientId    String
  eventType   String
  entityType  String?
  entityId    String?
  description String
  metadata    String?
  userId      String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@map("client_timeline")
}

model ClientRiskHistory {
  id            String    @id @default(uuid())
  clientId      String
  previousLevel RiskLevel
  newLevel      RiskLevel
  reason        String?
  riskScore     Int?
  source        String?
  userId        String?
  metadata      String?
  createdAt     DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@map("client_risk_history")
}

model ClientNote {
  id        String    @id @default(uuid())
  clientId  String
  noteType  String    @default("GENERAL")
  content   String
  userId    String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_notes")
}

model ClientVisit {
  id            String    @id @default(uuid())
  clientId      String
  userId        String
  visitType     String
  result        String
  latitude      Float?
  longitude     Float?
  accuracy      Float?
  capturedAt    DateTime  @default(now())
  notes         String?
  nextVisitDate DateTime?
  createdAt     DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([capturedAt])
  @@map("client_visits")
}

model ClientRenewal {
  id             String    @id @default(uuid())
  clientId       String
  sourceCreditId String?
  status         String    @default("PENDING")
  estimatedDate  DateTime?
  assignedTo     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_renewals")
}

model ProductCategory {
  id          String            @id @default(uuid())
  name        String
  description String?
  parentId    String?
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("product_categories")
}

model Product {
  id           String        @id @default(uuid())
  sku          String        @unique
  barcode      String?       @unique
  name         String
  description  String?
  brand        String?
  cost         Decimal       @default(0.00) @db.Decimal(12, 2)
  costPrice    Decimal       @default(0.00) @db.Decimal(12, 2)
  status       ProductStatus @default(ACTIVE)
  categoryId   String?
  minStock     Int           @default(0)
  reorderPoint Int           @default(0)
  maxStock     Int           @default(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category               ProductCategory?       @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  prices                 ProductPrice[]
  priceHistories         ProductPriceHistory[]
  stocks                 InventoryStock[]
  reservations           InventoryReservation[]
  kardexMovements        KardexMovement[]
  saleItems              SaleItem[]
  orderItems             ProductOrderItem[]
  authorizationRequests AuthorizationRequest[]

  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  storageKey String?
  isPrimary  Boolean  @default(false)
  isMain     Boolean  @default(false)
  sortOrder  Int      @default(0)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductPrice {
  id         String    @id @default(uuid())
  productId  String
  priceType  PriceType
  price      Decimal   @default(0.00) @db.Decimal(12, 2)
  amount     Decimal   @default(0.00) @db.Decimal(12, 2)
  validFrom  DateTime? @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, priceType])
  @@map("product_prices")
}

model ProductPriceHistory {
  id             String    @id @default(uuid())
  productId      String
  priceType      PriceType
  oldPrice       Decimal   @db.Decimal(12, 2)
  newPrice       Decimal   @db.Decimal(12, 2)
  userId         String?
  reason         String?
  ipAddress      String?
  idempotencyKey String?
  auditLogId     String?
  changedAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_price_history")
}

model Warehouse {
  id        String        @id @default(uuid())
  name      String        @unique
  code      String        @unique
  type      WarehouseType @default(CENTRAL)
  address   String?
  location  String?
  latitude  Float?
  longitude Float?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  stocks          InventoryStock[]
  reservations    InventoryReservation[]
  kardexMovements KardexMovement[]
  orders          ProductOrder[]

  @@map("warehouses")
}

model InventoryStock {
  id                String   @id @default(uuid())
  warehouseId       String
  productId         String
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0)
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@map("inventory_stock")
}

model InventoryReservation {
  id          String            @id @default(uuid())
  warehouseId String
  productId   String
  saleId      String?
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdBy   String?
  convertedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id])

  @@map("inventory_reservations")
}

model KardexMovement {
  id               String     @id @default(uuid())
  warehouseId      String
  productId        String
  type             KardexType
  movementType     KardexType @default(IN)
  quantity         Int
  previousQuantity Int?
  newQuantity      Int?
  reference        String?
  referenceType    String?
  referenceId      String?
  userId           String?
  idempotencyKey   String?
  notes            String?
  createdAt        DateTime   @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("kardex_movements")
}

model ProductOrder {
  id          String             @id @default(uuid())
  orderNumber String             @unique
  supplier    String?
  warehouseId String
  status      ProductOrderStatus @default(PENDING)
  totalAmount Decimal            @default(0.00) @db.Decimal(12, 2)
  userId      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     ProductOrderItem[]

  @@map("product_orders")
}

model ProductOrderItem {
  id                String   @id @default(uuid())
  orderId           String
  productId         String
  unitCost          Decimal  @db.Decimal(12, 2)
  quantityRequested Int
  quantityReceived  Int      @default(0)
  createdAt         DateTime @default(now())

  order   ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("product_order_items")
}

model AuthorizationRequest {
  id            String   @id @default(uuid())
  type          String
  status        String   @default("PENDING")
  requestedBy   String
  approvedBy    String?
  productId     String?
  saleId        String?
  proposedPrice Decimal? @db.Decimal(12, 2)
  minimumPrice  Decimal? @db.Decimal(12, 2)
  reason        String?
  payload       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
  sale    Sale?    @relation(fields: [saleId], references: [id])

  @@map("authorization_requests")
}

model Sale {
  id             String     @id @default(uuid())
  saleNumber     String     @unique
  clientId       String
  sellerId       String
  supervisorId   String?
  saleType       SaleType   @default(CREDIT)
  status         SaleStatus @default(DRAFT)
  subtotal       Decimal    @default(0.00) @db.Decimal(12, 2)
  totalListPrice Decimal    @default(0.00) @db.Decimal(12, 2)
  totalDiscount  Decimal    @default(0.00) @db.Decimal(12, 2)
  totalFinanced  Decimal    @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal    @default(0.00) @db.Decimal(12, 2)
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client                Client                 @relation(fields: [clientId], references: [id])
  seller                User                   @relation("SellerSales", fields: [sellerId], references: [id])
  supervisor            User?                  @relation("SupervisorSales", fields: [supervisorId], references: [id])
  items                 SaleItem[]
  credits               Credit[]
  downPayment           SaleDownPayment?
  companyContribution   CompanyContribution?
  downPaymentException  DownPaymentException?
  settlements           Settlement[]
  commissions           Commission[]
  reservations          InventoryReservation[]
  authorizationRequests AuthorizationRequest[]

  @@index([clientId])
  @@index([sellerId])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id                     String   @id @default(uuid())
  saleId                 String
  productId              String
  quantity               Int
  unitPrice              Decimal  @db.Decimal(12, 2)
  subtotal               Decimal  @default(0.00) @db.Decimal(12, 2)
  minimumAuthorizedPrice Decimal  @default(0.00) @db.Decimal(12, 2)
  negotiatedPrice        Decimal  @default(0.00) @db.Decimal(12, 2)
  discount               Decimal  @default(0.00) @db.Decimal(12, 2)
  financedAmount         Decimal  @default(0.00) @db.Decimal(12, 2)
  total                  Decimal  @default(0.00) @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  credits Credit[]

  @@map("sale_items")
}

model SaleDownPayment {
  id              String        @id @default(uuid())
  saleId          String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  status          String        @default("COMPLETED")
  paymentId       String?
  cashMovementId String?
  createdBy       String?
  createdAt       DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_down_payments")
}

model CompanyContribution {
  id                String   @id @default(uuid())
  saleId            String   @unique
  amount            Decimal  @db.Decimal(12, 2)
  rule              String   @default("MATCH_DOWN_PAYMENT_1_TO_1")
  percentageOrRatio Decimal  @default(1.00) @db.Decimal(12, 2)
  createdBy         String?
  createdAt         DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("company_contributions")
}

model DownPaymentException {
  id              String    @id @default(uuid())
  saleId          String    @unique
  requestedAmount Decimal   @db.Decimal(12, 2)
  reason          String
  requestedBy     String
  approvedBy      String?
  status          String    @default("PENDING")
  deadline        DateTime?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("down_payment_exceptions")
}

model Credit {
  id                   String           @id @default(uuid())
  saleId               String
  clientId             String
  saleItemId           String?
  productId            String?
  principalAmount      Decimal          @db.Decimal(12, 2)
  engancheCliente      Decimal          @db.Decimal(12, 2)
  aporteEmpresa        Decimal          @db.Decimal(12, 2)
  saldoActual          Decimal          @db.Decimal(12, 2)
  paymentFrequency     PaymentFrequency @default(WEEKLY)
  suggestedInstallment Decimal          @db.Decimal(12, 2)
  status               CreditStatus     @default(ACTIVE)
  proximaVisita        DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sale             Sale                @relation(fields: [saleId], references: [id])
  client           Client              @relation(fields: [clientId], references: [id])
  saleItem         SaleItem?           @relation(fields: [saleItemId], references: [id])
  schedules        PaymentSchedule[]
  payments         Payment[]
  settlements      Settlement[]
  commissions      Commission[]
  reschedules      PaymentReschedule[]
  promises         PaymentPromise[]
  collectionVisits CollectionVisit[]

  @@index([clientId])
  @@index([status])
  @@map("credits")
}

model Payment {
  id                 String             @id @default(uuid())
  creditId           String
  collectorId        String
  cashSessionId      String?
  amount             Decimal            @db.Decimal(12, 2)
  paymentMethod      PaymentMethod      @default(CASH)
  verificationStatus VerificationStatus @default(VERIFIED)
  idempotencyKey     String             @unique
  clientCapturedAt   DateTime
  serverReceivedAt   DateTime           @default(now())
  gpsLatitude        Float?
  gpsLongitude       Float?
  notes              String?
  paymentType        String?            @default("REGULAR")
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNotes  String?
  createdAt          DateTime           @default(now())

  credit      Credit       @relation(fields: [creditId], references: [id])
  collector   User         @relation("CollectorPayments", fields: [collectorId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([creditId])
  @@index([collectorId])
  @@index([idempotencyKey])
  @@map("payments")
}

model PaymentSchedule {
  id                    String              @id @default(uuid())
  creditId              String
  installmentNumber     Int
  scheduledDate         DateTime
  originalScheduledDate DateTime
  suggestedAmount       Decimal             @db.Decimal(12, 2)
  status                ScheduleStatus      @default(PENDING)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  reschedules           PaymentReschedule[]

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([scheduledDate])
  @@index([status])
  @@map("payment_schedules")
}

model CashSession {
  id               String            @id @default(uuid())
  userId           String
  collectorId      String?
  openedAt         DateTime          @default(now())
  openedClientAt   DateTime?
  closedAt         DateTime?
  closedClientAt   DateTime?
  openingFund      Decimal           @default(0.00) @db.Decimal(12, 2)
  currentCash      Decimal           @default(0.00) @db.Decimal(12, 2)
  status           CashSessionStatus @default(OPEN)
  openingLatitude  Float?
  openingLongitude Float?
  closingLatitude  Float?
  closingLongitude Float?
  deviceId         String?
  openingNotes     String?
  closingNotes     String?
  expectedCash     Decimal           @default(0.00) @db.Decimal(12, 2)
  countedCash      Decimal?          @db.Decimal(12, 2)
  varianceAmount   Decimal?          @db.Decimal(12, 2)
  openedBy         String?
  closedBy         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  payments  Payment[]
  movements CashMovement[]
  expenses  Expense[]
  counts    CashCount[]
  variances CashVariance[]

  @@index([userId])
  @@index([collectorId])
  @@index([status])
  @@map("cash_sessions")
}

model CashMovement {
  id               String       @id @default(uuid())
  cashSessionId    String
  collectorId      String?
  paymentId        String?
  type             MovementType
  amount           Decimal      @db.Decimal(12, 2)
  reference        String?
  description      String?
  clientId         String?
  clientCapturedAt DateTime?
  serverReceivedAt DateTime     @default(now())
  idempotencyKey   String?      @unique
  createdBy        String?
  auditLogId       String?
  createdAt        DateTime     @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@index([collectorId])
  @@index([type])
  @@index([idempotencyKey])
  @@map("cash_movements")
}

model PaymentReschedule {
  id                String   @id @default(uuid())
  creditId          String
  paymentScheduleId String
  previousDate      DateTime
  newDate           DateTime
  reason            String
  notes             String?
  gpsLatitude       Float?
  gpsLongitude      Float?
  createdBy         String?
  createdAt         DateTime @default(now())

  credit          Credit          @relation(fields: [creditId], references: [id], onDelete: Cascade)
  paymentSchedule PaymentSchedule @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([paymentScheduleId])
  @@map("payment_reschedules")
}

model PaymentPromise {
  id                 String    @id @default(uuid())
  creditId           String
  clientId           String
  promisedAmount     Decimal   @db.Decimal(12, 2)
  promisedDate       DateTime
  status             String    @default("PENDING")
  notes              String?
  gpsLatitude        Float?
  gpsLongitude       Float?
  createdBy          String?
  createdAt          DateTime  @default(now())
  fulfilledAt        DateTime?
  fulfilledPaymentId String?

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([clientId])
  @@index([promisedDate])
  @@index([status])
  @@map("payment_promises")
}

model CollectionVisit {
  id               String   @id @default(uuid())
  clientId         String
  creditId         String?
  userId           String
  visitType        String
  result           String
  noPaymentReason  String?
  gpsLatitude      Float?
  gpsLongitude     Float?
  accuracy         Float?
  notes            String?
  idempotencyKey   String?  @unique
  clientCapturedAt DateTime @default(now())
  serverReceivedAt DateTime @default(now())
  createdAt        DateTime @default(now())

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credit Credit? @relation(fields: [creditId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([creditId])
  @@index([userId])
  @@map("collection_visits")
}

model Expense {
  id               String    @id @default(uuid())
  cashSessionId    String
  userId           String
  collectorId      String?
  amount           Decimal   @db.Decimal(12, 2)
  expenseType      String    @default("GENERAL")
  category         String    @default("GENERAL")
  description      String
  expenseDate      DateTime? @default(now())
  receiptMediaId   String?
  status           String    @default("PENDING_REVIEW")
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  clientCapturedAt DateTime?
  serverReceivedAt DateTime  @default(now())
  idempotencyKey   String?   @unique
  gpsLatitude      Float?
  gpsLongitude     Float?
  createdAt        DateTime  @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@index([userId])
  @@index([collectorId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("expenses")
}

model CashCount {
  id            String   @id @default(uuid())
  cashSessionId String
  countedBy     String
  countedAt     DateTime @default(now())
  bills1000     Int      @default(0)
  bills500      Int      @default(0)
  bills200      Int      @default(0)
  bills100      Int      @default(0)
  bills50       Int      @default(0)
  bills20       Int      @default(0)
  bills10       Int      @default(0)
  bills5        Int      @default(0)
  bills2        Int      @default(0)
  bills1        Int      @default(0)
  coins1        Int      @default(0)
  coins2        Int      @default(0)
  coins5        Int      @default(0)
  coins10       Int      @default(0)
  coins20       Int      @default(0)
  totalCounted  Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@map("cash_counts")
}

model CashVariance {
  id             String    @id @default(uuid())
  cashSessionId  String
  expectedAmount Decimal   @db.Decimal(12, 2)
  countedAmount  Decimal   @db.Decimal(12, 2)
  varianceAmount Decimal   @db.Decimal(12, 2)
  varianceType   String
  reason         String?
  justification  String?
  status         String    @default("PENDING_REVIEW")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@index([status])
  @@map("cash_variances")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  endpoint       String
  responseBody   String
  statusCode     Int
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
  @@map("idempotency_records")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  action         String
  entity         String
  entityId       String
  oldValues      String?
  newValues      String?
  ipAddress      String?
  userAgent      String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Settlement {
  id                 String        @id @default(uuid())
  saleId             String?
  creditId           String
  outstandingBalance Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @db.Decimal(12, 2)
  settlementAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  paymentId          String?
  cashMovementId     String?
  status             String        @default("COMPLETED")
  createdBy          String
  createdAt          DateTime      @default(now())

  sale   Sale?  @relation(fields: [saleId], references: [id])
  credit Credit @relation(fields: [creditId], references: [id])

  @@map("settlements")
}

model CommissionRule {
  id                        String   @id @default(uuid())
  role                      String   // VENDEDORA, COBRADOR, SUPERVISORA
  ruleType                  String   // CASH_SALE, CREDIT_HIGH_DOWN, CREDIT_LOW_DOWN, COLLECTION, SUPERVISOR_SALE, SUPERVISOR_COLLECTION
  minDownPaymentPercentage  Decimal? @db.Decimal(5, 2)
  rate                      Decimal  @db.Decimal(5, 4)
  active                    Boolean  @default(true)
  description               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([role])
  @@index([ruleType])
  @@map("commission_rules")
}

model CommissionBonus {
  id                String    @id @default(uuid())
  name              String
  role              String
  productCategoryId String?
  percentage        Decimal?  @db.Decimal(5, 4)
  fixedAmount       Decimal?  @db.Decimal(12, 2)
  minSales          Int?
  minAmount         Decimal?  @db.Decimal(12, 2)
  startDate         DateTime?
  endDate           DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([role])
  @@index([active])
  @@map("commission_bonuses")
}

model CommissionPenalty {
  id           String   @id @default(uuid())
  employeeId   String
  reason       String   // CANCELLED_SALE, RETURNED_PRODUCT, UNAUTHORIZED_DISCOUNT, OTHER
  amount       Decimal  @db.Decimal(12, 2)
  authorizedBy String?
  periodId     String?
  notes        String?
  appliedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([periodId])
  @@map("commission_penalties")
}

model CommissionTarget {
  id           String   @id @default(uuid())
  employeeId   String
  role         String
  period       String   @default("MONTHLY") // MONTHLY, WEEKLY
  targetAmount Decimal  @db.Decimal(12, 2)
  bonusRate    Decimal? @db.Decimal(5, 4)
  bonusFixed   Decimal? @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([role])
  @@map("commission_targets")
}

model CommissionPeriod {
  id                         String    @id @default(uuid())
  periodName                 String?
  startDate                  DateTime
  endDate                    DateTime
  status                     String    @default("OPEN") // OPEN, CALCULATING, PENDING_APPROVAL, CLOSED, PAID
  totalSalesCommission       Decimal   @default(0) @db.Decimal(12, 2)
  totalCollectionCommission Decimal   @default(0) @db.Decimal(12, 2)
  totalSupervisorCommission Decimal   @default(0) @db.Decimal(12, 2)
  totalBonuses               Decimal   @default(0) @db.Decimal(12, 2)
  totalPenalties             Decimal   @default(0) @db.Decimal(12, 2)
  totalNet                   Decimal   @default(0) @db.Decimal(12, 2)
  snapshotHash               String?
  closedAt                   DateTime?
  closedBy                   String?
  approvedAt                 DateTime?
  approvedBy                 String?
  paidAt                     DateTime?
  paidBy                     String?
  createdAt                  DateTime  @default(now())

  @@index([status])
  @@index([startDate, endDate])
  @@map("commission_periods")
}

model Commission {
  id               String    @id @default(uuid())
  employeeId       String
  role             String
  commissionType   String    @default("SALE_COMMISSION") // SALE_COMMISSION, COLLECTION_COMMISSION, SUPERVISOR_SALE, SUPERVISOR_COLLECTION, BONUS, PENALTY, REVERSAL
  saleId           String?
  paymentId        String?
  creditId         String?
  supervisorId     String?
  routeId          String?
  zoneId           String?
  periodId         String?
  baseAmount       Decimal   @default(0) @db.Decimal(12, 2)
  rate             Decimal   @default(0) @db.Decimal(5, 4)
  bonusAmount      Decimal   @default(0) @db.Decimal(12, 2)
  penaltyAmount    Decimal   @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal   @db.Decimal(12, 2)
  status           String    @default("CALCULATED") // PENDING, CALCULATED, APPROVED, PAID, REVERSED, CANCELLED
  sourceEvent      String?
  idempotencyKey   String?   @unique
  reversalOfId     String?
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?
  paidAt           DateTime?
  createdBy        String?
  approvedBy       String?

  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  credit Credit? @relation(fields: [creditId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([role])
  @@index([periodId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("commissions")
}

model SyncOperation {
  id               String   @id @default(uuid())
  idempotencyKey   String   @unique
  deviceId         String
  userId           String
  operationType    String   // PAYMENT, DOWN_PAYMENT, VISIT, NON_PAYMENT_REASON, RESCHEDULE, PAYMENT_PROMISE, EXPENSE, GPS_TRACE, CLIENT, SALE
  entityType       String?
  entityId         String?
  clientCapturedAt DateTime
  serverReceivedAt DateTime @default(now())
  status           String   @default("QUEUED") // QUEUED, PROCESSING, SYNCED, CONFLICT, REJECTED, FAILED
  payload          String?  @db.Text
  payloadHash      String?
  retryCount       Int      @default(0)
  errorCode        String?
  errorMessage     String?
  conflictCode     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conflicts SyncConflict[]

  @@index([deviceId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("sync_operations")
}

model SyncConflict {
  id              String    @id @default(uuid())
  syncOperationId String?
  idempotencyKey  String?
  conflictType    String    // CLOCK_SKEW, DUPLICATE_OPERATION, STALE_DATA, INVALID_STATE, CREDIT_CLOSED, USER_NOT_AUTHORIZED, ROUTE_MISMATCH, BALANCE_CONFLICT, PAYLOAD_MISMATCH
  severity        String    @default("MEDIUM")
  description     String?
  originalPayload String?   @db.Text
  serverState     String?   @db.Text
  clientCapturedAt DateTime?
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?   // FORCE_SYNC, REJECT, REVIEW
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  syncOperation SyncOperation? @relation(fields: [syncOperationId], references: [id], onDelete: SetNull)

  @@index([syncOperationId])
  @@index([idempotencyKey])
  @@index([conflictType])
  @@index([resolvedAt])
  @@map("sync_conflicts")
}


