# BITALIS - Hostinger Node.js production variables
# NEVER commit real secrets to GitHub.

NODE_ENV=production

# Hostinger MySQL
DATABASE_URL="mysql://u490535922_bitalis:REPLACE_WITH_DATABASE_PASSWORD@srv1356.hstgr.io:3306/u490535922_bitalis"

# Application
NEXTAUTH_URL="https://REPLACE_WITH_YOUR_DOMAIN"
# Required. Generate at least 32 random bytes, for example: openssl rand -base64 48
# The application intentionally refuses to authenticate when this value is absent or weak.
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Persistent media. Optional: when omitted BITALIS uses $HOME/.bitalis/media
# Keep this directory outside the application/release folder.
BITALIS_UPLOAD_DIR=""

# Optional integrations - configure only when used
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Prisma
PRISMA_GENERATE_SKIP_AUTOINSTALL=true
